gree programme&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009e73&quot;&gt;weak_internal: some (not all) DISI teachers and DISI degree programmes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;internal: only DISI teachers and DISI degree programmes&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#f3f3f3;strokeColor=#999;fontSize=14;" vertex="1" parent="1"><mxGeometry x="876.8" y="12.0" width="573.6" height="139.4" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P0" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
