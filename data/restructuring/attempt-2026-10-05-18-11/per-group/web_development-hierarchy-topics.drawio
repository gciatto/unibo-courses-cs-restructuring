_deployment_platforms&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0072b2&quot;&gt;embedded_systems&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#aa4499&quot;&gt;embedded_device_communications&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#d55e00&quot;&gt;embedded_firmware_and_platform_development&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;mobile_application_delivery_models&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;native_mobile_application_development&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;mobile_device_services&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#24527a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="192.1" y="299.2" width="410.4" height="247.2" as="geometry"/></mxCell><mxCell id="P2" value="Context-Aware and Location-Based Systems&lt;br&gt;9 ECTS&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;context_adaptive_systems&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;human_activity_recognition&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;location_based_context_services&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;positioning_for_mobile_systems&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;spatial_data_privacy&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;mobile_middleware_architectures&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0072b2&quot;&gt;edge_fog_and_mobile_service_management&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#009e73&quot;&gt;mobility_management&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#24527a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="586.4" width="367.9" height="185.6" as="geometry"/></mxCell><mxCell id="P3" value="Mobile Application Engineering&lt;br&gt;6 ECTS&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;mobile_user_interface_development&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#000000&quot;&gt;cross_platform_mobile_development&lt;/fon